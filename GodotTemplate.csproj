<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <!-- ImplicitUsings: pulls in System.*, System.Collections.Generic, etc. so
         feature files (e.g. Juan's Match3 algorithm layer) don't need to
         spell out each using directive. Matches the test project's setting. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Disable SDK's default AssemblyInfo generation — Godot.NET.Sdk emits its
         own AssemblyInfo with Godot-specific attributes. Without these, you
         get CS0579 "Duplicate AssemblyXxxAttribute" errors. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <!--
    Exclude framework's samples/ directory from the main project's default
    Compile glob. Godot.NET.Sdk walks the entire project tree and would
    otherwise pull samples/Demo/AudioService.cs + 4 panel classes into
    GodotTemplate.dll, polluting the main assembly. Verified by strings
    inspection on 2026-10-05: 4 demo classes were present before this fix.

    Ref: addons/godot-framework/docs/design_v0.1.md §9 #8 — "MSBuild default
         Compile glob walks entire project tree; csproj must explicitly
         <Compile Remove> folders it doesn't want."

    Ref: addons/godot-framework/README.md §"Integration → Pattern A" — the
         library README acknowledges this is the consumer's responsibility.
  -->
  <ItemGroup>
    <Compile Remove="addons/godot-framework/samples/**/*.cs" />
  </ItemGroup>
  <!-- GameFramework submodule at addons/godot-framework/src/ is picked up by
       the .NET SDK's default Compile glob — that's intentional (Pattern A
       from the framework README). -->
</Project>
