<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GodotTemplate.Match3Tests</RootNamespace>
    <AssemblyName>Match3Tests</AssemblyName>
    <!-- Self-contained AOT-friendly defaults; tweak per env if needed. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      DISABLE_EVENTBUS: skip EventBus.Instance.Publish calls + omit
      GameFramework/Events imports in algorithm files compiled here.
      Keeps the test csproj pure .NET 9 (no Godot / framework dependency).
      The event flow is still verified via the legacy [Obsolete] PhaseChanged
      event in GameState (test code uses pragma warning disable CS0618).
    -->
    <DefineConstants>$(DefineConstants);DISABLE_EVENTBUS</DefineConstants>
  </PropertyGroup>

  <!--
    Pull algorithm sources in directly so the test project doesn't depend on
    a separate csproj. Pure .NET 9 — exclude Godot-using files (those are
    only compiled by GodotTemplate.csproj with the Godot.NET.Sdk).
    Algorithm files: Board.cs, GameState.cs, Gem.cs, MatchEngine.cs, ScoreManager.cs
    Godot-using files (excluded): Match3Feature.cs, Match3BoardView.cs,
                                  GameScenes.cs, SpritePaths.cs
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Features\Match3\Board.cs"          LinkBase="Match3" />
    <Compile Include="..\..\src\Features\Match3\GameState.cs"      LinkBase="Match3" />
    <Compile Include="..\..\src\Features\Match3\Gem.cs"            LinkBase="Match3" />
    <Compile Include="..\..\src\Features\Match3\MatchEngine.cs"    LinkBase="Match3" />
    <Compile Include="..\..\src\Features\Match3\ScoreManager.cs"   LinkBase="Match3" />
  </ItemGroup>
</Project>